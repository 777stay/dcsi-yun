<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.whu.yun.mapper.UserMapper">

    <select id="findByUsername" parameterType="string" resultType="com.whu.yun.entity.User">
        SELECT id, username, password FROM user WHERE username = #{username}
    </select>

    <insert id="insertUser" parameterType="com.whu.yun.entity.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password) VALUES (#{username}, #{password})
    </insert>

</mapper>

