TZ=Asia/Shanghai

MYSQL_ROOT_PASSWORD=replace-this-password
MYSQL_DATABASE=mydatabase
MYSQL_USER=root
MYSQL_PASSWORD=replace-this-password

BACKEND_PORT=8080
GRPC_PORT=50052
FRONTEND_PORT=80

JAVA_TOOL_OPTIONS=-Xms2g -Xmx4g -XX:+UseG1GC
APP_JWT_SECRET=replace-with-a-long-random-secret

# Public URL prefix returned to the frontend for generated Potree data.
# In Docker, same-origin nginx serves this path.
FUSION_PUBLIC_PREFIX=/dist/data
